datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  PRODUCTION_SUPERVISOR
  SALES_EXECUTIVE
  INVENTORY_MANAGER
  FINANCIAL_AUDITOR
}

enum MaterialCategory {
  RAW
  PACKAGING
}

enum UomType {
  KG
  LITRE
  GRAM
  PIECE
  PACKET
  CARTON
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMode {
  NEFT
  RTGS
  UPI
  CHEQUE
  CASH
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_GRN
  PROD_ISSUE
  PROD_YIELD
  SALES_DISPATCH
  SCRAP_DAMAGE
  RETURN
  ADJUSTMENT
}

enum ItemType {
  MATERIAL
  PRODUCT
}

// -------------------------------------------------------------
// CORE & MASTERS
// -------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  role          UserRole  @default(SALES_EXECUTIVE)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  auditLogs     AuditLog[]
  stockMovements StockLedger[]
  salesOrders   SalesOrder[] @relation("SalesmanOrders")
  approvedOrders OrderApproval[]

  @@map("users")
}

model Customer {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  gstin         String?
  stateCode     String    @map("state_code") // e.g., "33" for Tamil Nadu
  billingAddress String   @map("billing_address")
  shippingAddress String  @map("shipping_address")
  creditLimit   Decimal   @default(0.00) @map("credit_limit") @db.Decimal(14, 2)
  currentOutstanding Decimal @default(0.00) @map("current_outstanding") @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  salesOrders   SalesOrder[]
  invoices      Invoice[]
  payments      Payment[]

  @@map("customers")
}

model Supplier {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  gstin         String?
  stateCode     String    @map("state_code")
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String
  createdAt     DateTime  @default(now()) @map("created_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Material {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String
  category            MaterialCategory
  uom                 UomType
  minReorderQty       Decimal          @default(0.0000) @map("min_reorder_qty") @db.Decimal(12, 4)
  currentStock        Decimal          @default(0.0000) @map("current_stock") @db.Decimal(12, 4)
  currentWeightedRate Decimal          @default(0.0000) @map("current_weighted_rate") @db.Decimal(12, 4)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  bomItems            BomItem[]
  poItems             PurchaseOrderItem[]
  grnItems            GrnItem[]
  batchIssues         BatchMaterialIssue[]

  @@map("materials")
}

model Product {
  id               String    @id @default(uuid())
  sku              String    @unique
  name             String
  hsnCode          String    @map("hsn_code") // e.g. "1905"
  uom              UomType   @default(PACKET)
  unitWeightGrams  Decimal   @map("unit_weight_grams") @db.Decimal(10, 2)
  sellingPrice     Decimal   @map("selling_price") @db.Decimal(14, 2)
  gstRate          Decimal   @default(5.00) @map("gst_rate") @db.Decimal(5, 2)
  currentStock     Decimal   @default(0.0000) @map("current_stock") @db.Decimal(12, 4)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  boms             Bom[]
  soItems          SalesOrderItem[]
  invoiceItems     InvoiceItem[]
  batches          ProductionBatch[]

  @@map("products")
}

// -------------------------------------------------------------
// BILL OF MATERIALS (BOM)
// -------------------------------------------------------------

model Bom {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  version         String    // e.g. "v1.0"
  batchOutputQty  Decimal   @map("batch_output_qty") @db.Decimal(12, 4) // e.g. 200.0000
  batchOutputUom  UomType   @default(PACKET) @map("batch_output_uom")
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  product         Product   @relation(fields: [productId], references: [id])
  items           BomItem[]
  batches         ProductionBatch[]

  @@unique([productId, version])
  @@map("boms")
}

model BomItem {
  id                  String    @id @default(uuid())
  bomId               String    @map("bom_id")
  materialId          String    @map("material_id")
  standardQty         Decimal   @map("standard_qty") @db.Decimal(12, 4)
  standardUom         UomType   @map("standard_uom")
  tolerancePercentage Decimal   @default(0.00) @map("tolerance_percentage") @db.Decimal(5, 2)

  bom                 Bom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material            Material  @relation(fields: [materialId], references: [id])

  @@map("bom_items")
}

// -------------------------------------------------------------
// PURCHASES & GRN
// -------------------------------------------------------------

model PurchaseOrder {
  id          String    @id @default(uuid())
  poNumber    String    @unique @map("po_number")
  supplierId  String    @map("supplier_id")
  orderDate   DateTime  @default(now()) @map("order_date")
  status      String    @default("ISSUED") // ISSUED, RECEIVED, CANCELLED
  totalAmount Decimal   @map("total_amount") @db.Decimal(14, 2)

  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
  grnReceipts GrnReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String    @id @default(uuid())
  purchaseOrderId String    @map("purchase_order_id")
  materialId      String    @map("material_id")
  orderedQty      Decimal   @map("ordered_qty") @db.Decimal(12, 4)
  unitPrice       Decimal   @map("unit_price") @db.Decimal(12, 4)
  totalPrice      Decimal   @map("total_price") @db.Decimal(14, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material        Material      @relation(fields: [materialId], references: [id])

  @@map("purchase_order_items")
}

model GrnReceipt {
  id              String    @id @default(uuid())
  grnNumber       String    @unique @map("grn_number")
  purchaseOrderId String    @map("purchase_order_id")
  receivedDate    DateTime  @default(now()) @map("received_date")
  invoiceNumber   String?   @map("invoice_number")
  notes           String?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  items           GrnItem[]

  @@map("grn_receipts")
}

model GrnItem {
  id          String    @id @default(uuid())
  grnId       String    @map("grn_id")
  materialId  String    @map("material_id")
  receivedQty Decimal   @map("received_qty") @db.Decimal(12, 4)
  unitRate    Decimal   @map("unit_rate") @db.Decimal(12, 4)
  totalAmount Decimal   @map("total_amount") @db.Decimal(14, 2)

  grn         GrnReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  material    Material   @relation(fields: [materialId], references: [id])

  @@map("grn_items")
}

// -------------------------------------------------------------
// PRODUCTION ENGINE & BATCH COSTING
// -------------------------------------------------------------

model ProductionBatch {
  id              String      @id @default(uuid())
  batchNumber     String      @unique @map("batch_number")
  bomId           String      @map("bom_id")
  productId       String      @map("product_id")
  status          BatchStatus @default(PLANNED)
  plannedQty      Decimal     @map("planned_qty") @db.Decimal(12, 4) // e.g. 200.0000
  goodOutputQty   Decimal     @default(0.0000) @map("good_output_qty") @db.Decimal(12, 4) // e.g. 188.0000
  damagedOutputQty Decimal    @default(0.0000) @map("damaged_output_qty") @db.Decimal(12, 4)
  yieldVariancePercent Decimal @default(0.00) @map("yield_variance_percent") @db.Decimal(6, 2)
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  bom             Bom         @relation(fields: [bomId], references: [id])
  product         Product     @relation(fields: [productId], references: [id])
  materialIssues  BatchMaterialIssue[]
  costing         BatchCosting?

  @@map("production_batches")
}

model BatchMaterialIssue {
  id              String    @id @default(uuid())
  batchId         String    @map("batch_id")
  materialId      String    @map("material_id")
  standardQty     Decimal   @map("standard_qty") @db.Decimal(12, 4)
  actualIssuedQty Decimal   @map("actual_issued_qty") @db.Decimal(12, 4)
  scrapQty        Decimal   @default(0.0000) @map("scrap_qty") @db.Decimal(12, 4)
  variancePercent Decimal   @default(0.00) @map("variance_percent") @db.Decimal(6, 2)
  unitCost        Decimal   @map("unit_cost") @db.Decimal(12, 4)
  totalCost       Decimal   @map("total_cost") @db.Decimal(14, 2)

  batch           ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])

  @@map("batch_material_issues")
}

model BatchCosting {
  id                   String   @id @default(uuid())
  batchId              String   @unique @map("batch_id")
  rawMaterialCost      Decimal  @map("raw_material_cost") @db.Decimal(14, 2)
  packagingCost        Decimal  @map("packaging_cost") @db.Decimal(14, 2)
  directLabourCost     Decimal  @map("direct_labour_cost") @db.Decimal(14, 2)
  directOverheadCost   Decimal  @map("direct_overhead_cost") @db.Decimal(14, 2)
  totalProductionCost  Decimal  @map("total_production_cost") @db.Decimal(14, 2)
  costPerGoodPacket    Decimal  @map("cost_per_good_packet") @db.Decimal(12, 4)
  sellingPriceTarget   Decimal  @map("selling_price_target") @db.Decimal(14, 2)
  grossMarginAmount    Decimal  @map("gross_margin_amount") @db.Decimal(14, 2)
  grossMarginPercent   Decimal  @map("gross_margin_percent") @db.Decimal(5, 2)
  calculatedAt         DateTime @default(now()) @map("calculated_at")

  batch                ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("batch_costings")
}

// -------------------------------------------------------------
// SALES ORDERS, INVOICES & DISPATCH
// -------------------------------------------------------------

model SalesOrder {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique @map("order_number")
  customerId         String           @map("customer_id")
  salesmanId         String           @map("salesman_id")
  status             SalesOrderStatus @default(SUBMITTED)
  totalTaxableAmount Decimal          @map("total_taxable_amount") @db.Decimal(14, 2)
  totalTaxAmount     Decimal          @map("total_tax_amount") @db.Decimal(14, 2)
  totalOrderValue    Decimal          @map("total_order_value") @db.Decimal(14, 2)
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")

  customer           Customer         @relation(fields: [customerId], references: [id])
  salesman           User             @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  items              SalesOrderItem[]
  approvals          OrderApproval[]
  invoices           Invoice[]
  dispatches         Dispatch[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id              String     @id @default(uuid())
  salesOrderId    String     @map("sales_order_id")
  productId       String     @map("product_id")
  orderedQty      Decimal    @map("ordered_qty") @db.Decimal(12, 4)
  dispatchedQty   Decimal    @default(0.0000) @map("dispatched_qty") @db.Decimal(12, 4)
  shortageQty     Decimal    @default(0.0000) @map("shortage_qty") @db.Decimal(12, 4)
  unitPrice       Decimal    @map("unit_price") @db.Decimal(14, 2)
  taxableAmount   Decimal    @map("taxable_amount") @db.Decimal(14, 2)
  gstRate         Decimal    @map("gst_rate") @db.Decimal(5, 2)
  taxAmount       Decimal    @map("tax_amount") @db.Decimal(14, 2)
  totalAmount     Decimal    @map("total_amount") @db.Decimal(14, 2)

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

model OrderApproval {
  id            String    @id @default(uuid())
  salesOrderId  String    @map("sales_order_id")
  approvedById  String    @map("approved_by_id")
  isApproved    Boolean   @map("is_approved")
  remarks       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  approvedBy    User       @relation(fields: [approvedById], references: [id])

  @@map("order_approvals")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  salesOrderId    String        @map("sales_order_id")
  customerId      String        @map("customer_id")
  status          InvoiceStatus @default(POSTED)
  invoiceDate     DateTime      @default(now()) @map("invoice_date")
  taxableValue    Decimal       @map("taxable_value") @db.Decimal(14, 2)
  isInterState    Boolean       @default(false) @map("is_inter_state")
  cgstRate        Decimal       @default(2.50) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount      Decimal       @default(0.00) @map("cgst_amount") @db.Decimal(14, 2)
  sgstRate        Decimal       @default(2.50) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount      Decimal       @default(0.00) @map("sgst_amount") @db.Decimal(14, 2)
  igstRate        Decimal       @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount      Decimal       @default(0.00) @map("igst_amount") @db.Decimal(14, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(14, 2)
  paidAmount      Decimal       @default(0.00) @map("paid_amount") @db.Decimal(14, 2)
  balanceAmount   Decimal       @map("balance_amount") @db.Decimal(14, 2)

  salesOrder      SalesOrder    @relation(fields: [salesOrderId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  items           InvoiceItem[]
  allocations     PaymentAllocation[]

  @@map("invoices")
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  productId     String   @map("product_id")
  hsnCode       String   @map("hsn_code")
  quantity      Decimal  @db.Decimal(12, 4)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(14, 2)
  taxableAmount Decimal  @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount    Decimal  @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount    Decimal  @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount    Decimal  @map("igst_amount") @db.Decimal(14, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(14, 2)

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model Dispatch {
  id             String    @id @default(uuid())
  dispatchNumber String    @unique @map("dispatch_number")
  salesOrderId   String    @map("sales_order_id")
  dispatchDate   DateTime  @default(now()) @map("dispatch_date")
  vehicleNumber  String?   @map("vehicle_number")
  notes          String?

  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  items          DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id            String    @id @default(uuid())
  dispatchId    String    @map("dispatch_id")
  productId     String    @map("product_id")
  dispatchedQty Decimal   @map("dispatched_qty") @db.Decimal(12, 4)

  dispatch      Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@map("dispatch_items")
}

// -------------------------------------------------------------
// PAYMENTS & RECEIVABLES
// -------------------------------------------------------------

model Payment {
  id              String      @id @default(uuid())
  receiptNumber   String      @unique @map("receipt_number")
  customerId      String      @map("customer_id")
  paymentDate     DateTime    @default(now()) @map("payment_date")
  paymentAmount   Decimal     @map("payment_amount") @db.Decimal(14, 2)
  paymentMode     PaymentMode @default(NEFT) @map("payment_mode")
  referenceNumber String?     @map("reference_number") // e.g. UTR number
  notes           String?

  customer        Customer    @relation(fields: [customerId], references: [id])
  allocations     PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  invoiceId       String   @map("invoice_id")
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  allocatedAt     DateTime @default(now()) @map("allocated_at")

  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])

  @@map("payment_allocations")
}

// -------------------------------------------------------------
// IMMUTABLE STOCK LEDGER (DOUBLE-ENTRY)
// -------------------------------------------------------------

model StockLedger {
  id                    String            @id @default(uuid())
  transactionRef        String            @unique @map("transaction_ref")
  itemType              ItemType          @map("item_type")
  itemId                String            @map("item_id")
  movementType          StockMovementType @map("movement_type")
  quantityIn            Decimal           @default(0.0000) @map("quantity_in") @db.Decimal(12, 4)
  quantityOut           Decimal           @default(0.0000) @map("quantity_out") @db.Decimal(12, 4)
  balanceAfter          Decimal           @map("balance_after") @db.Decimal(12, 4)
  uom                   UomType
  unitRate              Decimal           @default(0.0000) @map("unit_rate") @db.Decimal(12, 4)
  totalValuation        Decimal           @default(0.00) @map("total_valuation") @db.Decimal(14, 2)
  referenceDocumentType String            @map("reference_document_type") // PO, GRN, BATCH, INVOICE, DISPATCH
  referenceDocumentId   String            @map("reference_document_id")
  createdById           String            @map("created_by_id")
  createdAt             DateTime          @default(now()) @map("created_at")

  createdBy             User              @relation(fields: [createdById], references: [id])

  @@index([itemId, itemType])
  @@index([createdAt])
  @@index([referenceDocumentType, referenceDocumentId])
  @@map("stock_ledger")
}

// -------------------------------------------------------------
// IMMUTABLE AUDIT LOGS
// -------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actionType    String   @map("action_type") // CREATE, UPDATE, APPROVE, POST, DISPATCH
  entityName    String   @map("entity_name") // SalesOrder, Batch, Invoice, StockLedger
  entityId      String   @map("entity_id")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  actor         User?    @relation(fields: [actorId], references: [id])

  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
